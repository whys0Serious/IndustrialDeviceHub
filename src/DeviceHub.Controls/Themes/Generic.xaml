<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DeviceHub.Controls.Controls">

    <Style TargetType="{x:Type controls:DeviceStatusIndicator}">
        <Setter Property="ToolTip" Value="{Binding StatusText, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DeviceStatusIndicator}">
                    <Grid Width="{TemplateBinding DotSize}" Height="{TemplateBinding DotSize}">
                        <!-- 底层：发光圆（同色，模糊） -->
                        <Ellipse Fill="{TemplateBinding StatusBrush}" Opacity="0.6">
                            <Ellipse.Effect>
                                <BlurEffect Radius="8"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- 中层：实心圆 -->
                        <Ellipse Fill="{TemplateBinding StatusBrush}"/>

                        <!-- 顶层：高光 -->
                        <Ellipse HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="{TemplateBinding DotSize}" Height="{TemplateBinding DotSize}"
                         Margin="2,2,0,0" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#B0FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--自定义窗口-->
    <Style TargetType="{x:Type controls:CustomWindow}">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CustomWindow}">
                    <!-- 弹窗时 Margin=16 给阴影留空间；主窗体时 0 -->
                    <Grid x:Name="RootGrid" Margin="0">

                        <!-- ★ 阴影承载层（主窗体时无阴影，弹窗时有） -->
                        <Grid x:Name="ShadowHost" Background="Transparent">
                            <Grid.Effect>
                                <DropShadowEffect x:Name="ShadowEffect"
                                                  BlurRadius="32"
                                                  ShadowDepth="4"
                                                  Direction="270"
                                                  Opacity="0.25"
                                                  Color="#1E293B"/>
                            </Grid.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <controls:TitleBarControl x:Name="TitleBar"
                                    CornerRadius="0"
                                    WindowTitle="{TemplateBinding Title}"
                                    ShowMinimize="{TemplateBinding ShowMinimize}"
                                    ShowMaximize="{TemplateBinding ShowMaximize}"
                                    ShowClose="{TemplateBinding ShowClose}"
                                    LeftContent="{TemplateBinding LeftContent}"
                                    RightContent="{TemplateBinding RightContent}"/>

                                <!-- ★ 内容区：背景由触发器决定；圆角由触发器决定 -->
                                <Border x:Name="ContentBorder"
                                        Grid.Row="1"
                                        Background="{DynamicResource BackgroundBrush}"
                                        CornerRadius="0">
                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- ★ 弹窗模式：透明窗口，用圆角 + 阴影 -->
                        <Trigger Property="IsDialog" Value="True">
                            <!-- 内容区背景：弹窗用 SurfaceBrush（白） -->
                            <Setter TargetName="ContentBorder" Property="Background"
                                    Value="{DynamicResource SurfaceBrush}"/>
                            <Setter TargetName="ContentBorder" Property="CornerRadius" Value="0,0,5,5"/>
                            <Setter TargetName="TitleBar" Property="CornerRadius" Value="5,5,0,0"/>

                            <!-- 阴影：弹窗有 -->
                            <Setter TargetName="RootGrid" Property="Margin" Value="16"/>
                        </Trigger>

                        <!-- 弹窗无阴影 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDialog" Value="True"/>
                                <Condition Property="HasShadow" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ShadowHost" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="RootGrid" Property="Margin" Value="0"/>
                        </MultiTrigger>

                        <!-- 主窗体模式：非透明窗口，直角，无阴影 -->
                        <Trigger Property="IsDialog" Value="False">
                            <Setter TargetName="ContentBorder" Property="Background"
                                    Value="{DynamicResource BackgroundBrush}"/>
                            <Setter TargetName="ContentBorder" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="TitleBar" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="ShadowHost" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="RootGrid" Property="Margin" Value="0"/>
                        </Trigger>

                        <!-- 最大化：贴边、去阴影、去圆角 -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="ShadowHost" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="RootGrid" Property="Margin" Value="0"/>
                            <Setter TargetName="ContentBorder" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="TitleBar" Property="CornerRadius" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 警告条-->
    <Style TargetType="{x:Type controls:AlarmBanner}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AlarmBanner}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 图标 -->
                        <TextBlock Text="⚠"
                               FontSize="13"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                        <!-- 数量 -->
                        <TextBlock FontSize="12"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0">
                        <Run Text="{Binding Count, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                             FontWeight="Bold"/>
                        <Run Text=" 条未确认报警"/>
                        </TextBlock>

                        <!-- 消息 -->
                        <TextBlock Text="{TemplateBinding Message}"
                               FontSize="12"
                               Foreground="{DynamicResource WarningDarkBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="400"/>

                        <!-- 查看按钮 -->
                        <Button Grid.Column="2"
                                Content="查看"
                                Command="{TemplateBinding ViewCommand}"
                                Background="Transparent"
                                Foreground="{DynamicResource PrimaryBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="13"
                                Padding="8,0"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>