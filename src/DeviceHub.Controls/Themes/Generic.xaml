<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DeviceHub.Controls.Controls">

    <Style TargetType="{x:Type controls:DeviceStatusIndicator}">
        <Setter Property="ToolTip" Value="{Binding StatusText, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DeviceStatusIndicator}">
                    <Grid Width="{TemplateBinding DotSize}" Height="{TemplateBinding DotSize}">
                        <!-- 底层：发光圆（同色，模糊） -->
                        <Ellipse Fill="{TemplateBinding StatusBrush}" Opacity="0.6">
                            <Ellipse.Effect>
                                <BlurEffect Radius="8"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- 中层：实心圆 -->
                        <Ellipse Fill="{TemplateBinding StatusBrush}"/>

                        <!-- 顶层：高光 -->
                        <Ellipse HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="{TemplateBinding DotSize}" Height="{TemplateBinding DotSize}"
                         Margin="2,2,0,0" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#B0FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--自定义窗口-->
    <Style TargetType="{x:Type controls:CustomWindow}">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CustomWindow}">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <controls:TitleBarControl Grid.Row="0"
                            WindowTitle="{TemplateBinding Title}"
                            ShowMinimize="{TemplateBinding ShowMinimize}"
                            ShowMaximize="{TemplateBinding ShowMaximize}"
                            ShowClose="{TemplateBinding ShowClose}"
                            LeftContent="{TemplateBinding LeftContent}"
                            RightContent="{TemplateBinding RightContent}"/>

                            <ContentPresenter Grid.Row="1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 警告条-->
    <Style TargetType="{x:Type controls:AlarmBanner}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AlarmBanner}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 图标 -->
                        <TextBlock Text="⚠"
                               FontSize="13"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                        <!-- 数量 -->
                        <TextBlock FontSize="12"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0">
                        <Run Text="{Binding Count, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                             FontWeight="Bold"/>
                        <Run Text=" 条未确认报警"/>
                        </TextBlock>

                        <!-- 消息 -->
                        <TextBlock Text="{TemplateBinding Message}"
                               FontSize="12"
                               Foreground="{DynamicResource WarningDarkBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="400"/>

                        <!-- 查看按钮 -->
                        <Button Grid.Column="2"
                                Content="查看"
                                Command="{TemplateBinding ViewCommand}"
                                Background="Transparent"
                                Foreground="{DynamicResource PrimaryBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="13"
                                Padding="8,0"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>