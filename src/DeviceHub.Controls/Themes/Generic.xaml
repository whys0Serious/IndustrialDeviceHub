<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DeviceHub.Controls.Controls">

    <Style TargetType="{x:Type controls:DeviceStatusIndicator}">
        <Setter Property="ToolTip" Value="{Binding StatusText, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DeviceStatusIndicator}">
                    <Grid Width="{TemplateBinding DotSize}" Height="{TemplateBinding DotSize}">
                        <!-- 底层：发光圆（同色，模糊） -->
                        <Ellipse Fill="{TemplateBinding StatusBrush}" Opacity="0.6">
                            <Ellipse.Effect>
                                <BlurEffect Radius="8"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- 中层：实心圆 -->
                        <Ellipse Fill="{TemplateBinding StatusBrush}"/>

                        <!-- 顶层：高光 -->
                        <Ellipse HorizontalAlignment="Left" VerticalAlignment="Top"
                         Width="{TemplateBinding DotSize}" Height="{TemplateBinding DotSize}"
                         Margin="2,2,0,0" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#B0FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>