<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  关闭图标 (X)  -->
    <Geometry x:Key="Icon_Close">M 0,0 L 10,10 M 10,0 L 0,10</Geometry>

    <!--  最大化图标 (正方形)  -->
    <Geometry x:Key="Icon_Maximize">M 0,0 L 10,0 L 10,10 L 0,10 Z</Geometry>

    <!--  最小化图标 (横线)  -->
    <Geometry x:Key="Icon_Minimize">M 0,5 L 10,5</Geometry>

    <!--  还原图标 (两个叠放的正方形)  -->
    <Geometry x:Key="Icon_Restore">M 0,2 L 8,2 L 8,10 L 0,10 Z M 2,0 L 10,0 L 10,8 L 8,8</Geometry>
</ResourceDictionary>