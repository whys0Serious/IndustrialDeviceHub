<controls:CustomWindow x:Class="DeviceHub.Controls.Controls.AppMessageBox"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:controls="clr-namespace:DeviceHub.Controls.Controls"
                       Title="提示"
                       Width="420"
                       SizeToContent="Height"
                       MinHeight="160"
                       MaxHeight="600"
                       WindowStartupLocation="CenterOwner"
                       ResizeMode="NoResize"
                       ShowInTaskbar="False"
                       ShowMinimize="False"
                       ShowMaximize="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容区：图标 + 消息 -->
        <Grid Grid.Row="0" Margin="28,28,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 图标 -->
            <TextBlock x:Name="IconText"
                       Grid.Column="0"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="32"
                       Margin="0,0,18,0"
                       VerticalAlignment="Top"/>

            <!-- 消息正文 -->
            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="14"
                       LineHeight="22"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 按钮区 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceHoverBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,6,6"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 取消按钮（可选） -->
                <Button x:Name="SecondaryButton"
                        Content="取消"
                        MinWidth="88" Height="32"
                        Margin="0,0,10,0"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="SecondaryButton_Click"/>

                <!-- 确定按钮 -->
                <Button x:Name="PrimaryButton"
                        Content="确定"
                        MinWidth="88" Height="32"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="PrimaryButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</controls:CustomWindow>