<UserControl
    x:Class="DeviceHub.Controls.Controls.TitleBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeviceHub.Controls.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    x:Name="Root"
    Height="32"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DeviceHub.Controls;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource SidebarBackgroundBrush}" CornerRadius="{Binding CornerRadius, ElementName=Root}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!--  左侧自定义  -->
                <ColumnDefinition Width="*" />
                <!--  标题  -->
                <ColumnDefinition Width="Auto" />
                <!--  右侧自定义 + 按钮  -->
            </Grid.ColumnDefinitions>

            <!--  左侧  -->
            <ContentControl
                Grid.Column="0"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Content="{Binding LeftContent, ElementName=Root}" />

            <!--  标题  -->
            <TextBlock
                Grid.Column="1"
                Margin="10,0"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{DynamicResource TitleBarForegroundBrush}"
                IsHitTestVisible="False"
                Text="{Binding WindowTitle, ElementName=Root}"
                TextTrimming="CharacterEllipsis" />

            <!--  右侧  -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Orientation="Horizontal">

                <ContentControl
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Content="{Binding RightContent, ElementName=Root}" />

                <Button
                    Width="40"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="Minimize_Click">
                    <Button.Style>
                        <Style BasedOn="{StaticResource CaptionButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowMinimize, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource Icon_Minimize}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                </Button>

                <Button
                    x:Name="MaximizeButton"
                    Width="40"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="Maximize_Click">
                    <Button.Style>
                        <Style BasedOn="{StaticResource CaptionButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <!--  默认非最大化状态：显示最大化图标  -->
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Normal">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Path
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource Icon_Maximize}"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                StrokeThickness="1.2" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!--  最大化状态：显示还原图标  -->
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Path
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource Icon_Restore}"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                StrokeThickness="1.2" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!--  隐藏按钮  -->
                                <DataTrigger Binding="{Binding ShowMaximize, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button
                    Width="40"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="Close_Click">
                    <Button.Style>
                        <Style BasedOn="{StaticResource CloseButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowClose, ElementName=Root}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource Icon_Close}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.2" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
