{
  "ConnectionStrings": {
    "Default": "Server=localhost\\SQLEXPRESS;Database=DeviceHub;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Modbus": {
    "Enabled": false,
    "Host": "127.0.0.1",
    "Port": 502,
    "SlaveId": 1,
    "StartAddress": 0,
    "RegisterCount": 10,
    "PollingIntervalMs": 1000
  },
  "Alarm": {
    "TemperatureMax": 80,
    "PressureMax": 150,
    "SpeedMin": 500,
    "SuppressIntervalSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}