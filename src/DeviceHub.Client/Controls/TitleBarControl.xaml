<UserControl x:Class="DeviceHub.Client.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeviceHub.Client.Controls"
             mc:Ignorable="d" 
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
            x:Name="Root"
            Height="32">    
    <Border Background="{DynamicResource TitleBarBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- 左侧自定义 -->
                <ColumnDefinition Width="*"/>
                <!-- 标题 -->
                <ColumnDefinition Width="Auto"/>
                <!-- 右侧自定义 + 按钮 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧 -->
            <ContentControl Grid.Column="0"
                          Content="{Binding LeftContent, ElementName=Root}"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

            <!-- 标题 -->
            <TextBlock Grid.Column="1"
                     Text="{Binding WindowTitle, ElementName=Root}"
                     Foreground="{DynamicResource TitleBarForegroundBrush}"
                     FontSize="14"
                     Margin="10,0"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     IsHitTestVisible="False"/>

            <!-- 右侧 -->
            <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Stretch">

                <ContentControl Content="{Binding RightContent, ElementName=Root}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <Button Content="&#xE921;"
                      Width="40"
                      Style="{StaticResource CaptionButtonStyle}"
                      Click="Minimize_Click"
                      Visibility="{Binding ShowMinimize, ElementName=Root,
                                   Converter={StaticResource BoolToVisibility}}"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <Button Content="&#xE922;"
                      Width="40"
                      Style="{StaticResource CaptionButtonStyle}"
                      Click="Maximize_Click"
                      Visibility="{Binding ShowMaximize, ElementName=Root,
                                   Converter={StaticResource BoolToVisibility}}"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <Button Content="&#xE8BB;"
                      Width="40"
                      Style="{StaticResource CloseButtonStyle}"
                      Click="Close_Click"
                      Visibility="{Binding ShowClose, ElementName=Root,
                                   Converter={StaticResource BoolToVisibility}}"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
