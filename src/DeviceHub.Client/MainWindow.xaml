<controls:CustomWindow
    x:Class="DeviceHub.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cont="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
    xmlns:controls="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceHub.Client"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:DeviceHub.Client.Views"
    xmlns:vm="clr-namespace:DeviceHub.Client.ViewModels"
    x:Name="MainWindowRoot"
    Width="1200"
    Height="720"
    Background="{DynamicResource SidebarBackgroundBrush}"
    ShowMaximize="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--  标题栏右侧：主题切换按钮  -->
    <controls:CustomWindow.RightContent>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                FontSize="{DynamicResource FontSizeSmall}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Text="{Binding CurrentUserName}" />
            <TextBlock
                Margin="0,0,15,0"
                VerticalAlignment="Center"
                FontSize="{DynamicResource FontSizeSmall}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding CurrentUserRole}" />

            <Button
                Margin="0,0,10,0"
                Padding="6,0"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding LogoutCommand}"
                Content="🚪退出"
                Cursor="Hand"
                FontSize="{DynamicResource FontSizeSmall}"
                Foreground="{DynamicResource TitleBarForegroundBrush}" />

            <Button
                Height="32"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding ToggleThemeCommand}"
                Content="👚"
                Cursor="Hand"
                FontSize="{DynamicResource FontSizeSmall}"
                Foreground="{DynamicResource TitleBarForegroundBrush}"
                ToolTip="切换主题" />
        </StackPanel>
    </controls:CustomWindow.RightContent>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  左侧菜单  -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <StackPanel Margin="10">
                <TextBlock
                    Margin="0,9,0,30"
                    HorizontalAlignment="Center"
                    FontSize="{DynamicResource FontSizeFTitle}"
                    FontWeight="Bold"
                    Foreground="{DynamicResource SidebarTextBrush}"
                    Text="设备中枢" />
                <!--  加新页面  -->
                <RadioButton
                    Height="40"
                    Margin="0,5"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Type vm:DeviceListViewModel}"
                    Content="设备管理"
                    GroupName="MainMenu"
                    IsChecked="True"
                    Style="{StaticResource SidebarRadioButtonStyle}" />

                <RadioButton
                    Height="40"
                    Margin="0,5"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Type vm:DeviceCategoryListViewModel}"
                    Content="分类管理"
                    GroupName="MainMenu"
                    Style="{StaticResource SidebarRadioButtonStyle}" />
                <RadioButton
                    Height="40"
                    Margin="0,5"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Type vm:RecipeListViewModel}"
                    Content="配方管理"
                    GroupName="MainMenu"
                    Style="{StaticResource SidebarRadioButtonStyle}" />
                <RadioButton
                    Height="40"
                    Margin="0,5"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Type vm:RealtimeMonitorViewModel}"
                    Content="实时监控"
                    GroupName="MainMenu"
                    Style="{StaticResource SidebarRadioButtonStyle}" />

                <RadioButton
                    Height="40"
                    Margin="0,5"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Type vm:AlarmListViewModel}"
                    Content="报警列表"
                    GroupName="MainMenu"
                    Style="{StaticResource SidebarRadioButtonStyle}" />

                <RadioButton
                    Height="40"
                    Margin="0,5"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Type vm:WorkOrderListViewModel}"
                    Content="工单管理"
                    GroupName="MainMenu"
                    Style="{StaticResource SidebarRadioButtonStyle}" />

                <RadioButton
                    Height="40"
                    Margin="0,5"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Type vm:UserListViewModel}"
                    Content="用户管理"
                    GroupName="MainMenu"
                    Style="{StaticResource SidebarRadioButtonStyle}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}" />

                <RadioButton
                    Height="40"
                    Margin="0,5"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Type vm:AiChatViewModel}"
                    Content="AI 助手"
                    GroupName="MainMenu"
                    Style="{StaticResource SidebarRadioButtonStyle}" />
            </StackPanel>
        </Border>

        <!--  右侧根据 CurrentViewModel自动找DataTemplate  -->
        <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!--  上方页面内容  -->
                <RowDefinition Height="30" />
                <!--  下方全局状态栏  -->
            </Grid.RowDefinitions>
            <ContentControl
                Grid.Row="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{Binding CurrentViewModel}" />
            <!--  全局状态栏  -->
            <Border Grid.Row="1" Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal" />
                    <cont:AlarmBanner
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Count="{Binding AlarmBanner.UnacknowledgedCount}"
                        IsOpen="{Binding AlarmBanner.HasAlarms}"
                        Message="{Binding AlarmBanner.FirstAlarmMessage}"
                        ViewCommand="{Binding AlarmBanner.ViewAlarmsCommand}"
                        Visibility="{Binding AlarmBanner.HasAlarms, Converter={StaticResource BoolToVisibility}}" />
                    <!--  版本+时间  -->
                    <StackPanel
                        Grid.Column="2"
                        Margin="0,8,0,5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,20,0"
                            Cursor="Help"
                            FontSize="12"
                            Foreground="{DynamicResource SidebarTextSecondaryBrush}"
                            Text="{Binding ShortVersion, Mode=OneWay}"
                            ToolTip="{Binding FullVersion, Mode=OneWay}" />
                        <TextBlock
                            Margin="0,0,10,0"
                            FontSize="12"
                            Foreground="{DynamicResource SidebarTextBrush}"
                            Text="{Binding CurrentTime, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</controls:CustomWindow>
