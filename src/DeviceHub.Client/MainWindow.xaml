<controls:CustomWindow x:Class="DeviceHub.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceHub.Client"
        xmlns:controls="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
        xmlns:cont="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
        xmlns:vm="clr-namespace:DeviceHub.Client.ViewModels"
        xmlns:views="clr-namespace:DeviceHub.Client.Views"
        mc:Ignorable="d"
        x:Name="MainWindowRoot"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ShowMaximize="True"
        xmlns:hc="https://handyorg.github.io/handycontrol">
    <!-- 标题栏右侧：主题切换按钮 -->
    <controls:CustomWindow.RightContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentUserName}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding CurrentUserRole}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>

            <Button Content="🚪 退出"
                Command="{Binding LogoutCommand}"
                Background="Transparent"
                Foreground="{DynamicResource TitleBarForegroundBrush}"
                BorderThickness="0"
                Cursor="Hand"
                FontSize="12"
                Margin="0,0,10,0"
                Padding="6,0"/>

            <Button Content="🌓"
                Command="{Binding ToggleThemeCommand}"
                Background="Transparent"
                Foreground="{DynamicResource TitleBarForegroundBrush}"
                BorderThickness="0"
                Cursor="Hand"
                FontSize="16"
                Width="32" Height="32"
                ToolTip="切换主题"/>
        </StackPanel>
    </controls:CustomWindow.RightContent>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="13*"/>
            <ColumnDefinition Width="87*"/>
        </Grid.ColumnDefinitions>
        <!-- 左侧菜单 -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" Margin="0,0,0,30" Grid.RowSpan="2">
            <StackPanel Margin="10">
                <TextBlock Text="设备中枢" FontSize="20" FontWeight="Bold"
                        Foreground="{DynamicResource SidebarTextBrush}"
                        Margin="0,20,0,30" HorizontalAlignment="Center"/>
                <!--加新页面 -->
                <RadioButton Content="设备管理"
              GroupName="MainMenu"
              IsChecked="True"
              Height="40" Margin="0,5"
              Style="{StaticResource SidebarRadioButtonStyle}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Type vm:DeviceListViewModel}"/>

                <RadioButton Content="分类管理"
              GroupName="MainMenu"
              Height="40" Margin="0,5"
              Style="{StaticResource SidebarRadioButtonStyle}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Type vm:DeviceCategoryListViewModel}"/>

                <RadioButton Content="实时监控"
              GroupName="MainMenu"
              Height="40" Margin="0,5"
              Style="{StaticResource SidebarRadioButtonStyle}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Type vm:RealtimeMonitorViewModel}"/>

                <RadioButton Content="报警列表"
              GroupName="MainMenu"
              Height="40" Margin="0,5"
              Style="{StaticResource SidebarRadioButtonStyle}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Type vm:AlarmListViewModel}"/>

                <RadioButton Content="工单管理"
              GroupName="MainMenu"
              Height="40" Margin="0,5"
              Style="{StaticResource SidebarRadioButtonStyle}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Type vm:WorkOrderListViewModel}"/>

                <RadioButton Content="用户管理"
              GroupName="MainMenu"
              Height="40" Margin="0,5"
              Style="{StaticResource SidebarRadioButtonStyle}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Type vm:UserListViewModel}"
              Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"/>

                <RadioButton Content="AI 助手"
              GroupName="MainMenu"
              Height="40" Margin="0,5"
              Style="{StaticResource SidebarRadioButtonStyle}"
              Command="{Binding NavigateCommand}"
              CommandParameter="{x:Type vm:AiChatViewModel}"/>
            </StackPanel>
        </Border>

        <!--右侧根据 CurrentViewModel自动找DataTemplate-->
        <ContentControl Grid.Column="1"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Stretch" 
                     Content="{Binding CurrentViewModel}" Grid.ColumnSpan="2" Margin="0,0,0,30" Grid.RowSpan="2"/>
        <!-- 全局状态栏 -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                </StackPanel>

                <cont:AlarmBanner Grid.Column="0"
                       Message="{Binding AlarmBanner.FirstAlarmMessage}"
                       Count="{Binding AlarmBanner.UnacknowledgedCount}"
                       IsOpen="{Binding AlarmBanner.HasAlarms}"
                       ViewCommand="{Binding AlarmBanner.ViewAlarmsCommand}"
                     Visibility="{Binding AlarmBanner.HasAlarms,Converter={StaticResource BoolToVisibility}}"
                       VerticalAlignment="Center"/>
                <!-- 版本+时间 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 8 0 10">
                    <TextBlock Text="{Binding ShortVersion, Mode=OneWay}"
                            ToolTip="{Binding FullVersion, Mode=OneWay}"
                            Foreground="{DynamicResource SidebarTextSecondaryBrush}"
                            FontSize="12" Margin="0,0,20,0"
                            Cursor="Help"/>
                    <TextBlock Text="{Binding CurrentTime, Mode=OneWay}"
                            Foreground="{DynamicResource SidebarTextBrush}"
                            FontSize="12" Margin="0 0 10 0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</controls:CustomWindow>
