<Window x:Class="DeviceHub.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceHub.Client"
        xmlns:controls="clr-namespace:DeviceHub.Client.Controls"
        mc:Ignorable="d"
        Style="{StaticResource BaseWindowStyle}"
        Title="MainWindow" Height="690" Width="1200"
        xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <controls:TitleBarControl Grid.Row="0" Grid.ColumnSpan="2"
                            WindowTitle="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                            ShowMaximize="False">
            <!--自定义的模板中设置了左右两侧可进行增加控件操作-->
            <controls:TitleBarControl.LeftContent>
                <Image Source="/Assets/Icons/papirus.png"  Width="20" Height="20" Stretch="Uniform"/>
            </controls:TitleBarControl.LeftContent>
        </controls:TitleBarControl>
        <!-- 左侧菜单 -->
        <Border Grid.Column="0" Grid.Row="1" Background="{DynamicResource TitleBarBackgroundBrush}">
            <StackPanel Margin="10">
                <TextBlock Text="设备中枢" FontSize="20" FontWeight="Bold"
                           Foreground="White" Margin="0,20,0,30" HorizontalAlignment="Center"/>
                <!--加新页面 -->
                <Button Content="设备管理" Height="40" Margin="0,5"
                        Background="#34495E" Foreground="White" BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding NavigateToDeviceListCommand}"/>
            </StackPanel>
        </Border>

        <!--右侧根据 CurrentViewModel自动找DataTemplate-->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentViewModel}"/>
        <!-- 全局状态栏 -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#2C3E50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--服务状态区（M3填 Modbus，M6 填 AI）-->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 占位：M3 加 Modbus 状态，M6 加 AI 状态 -->
                </StackPanel>

                <!-- 后台任务区（M4 填导入进度等） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 占位-->
                    <!-- 
                    <TextBlock Text="正在导入知识库..." Foreground="White" FontSize="12"/>
                    <ProgressBar Value="45" Width="100" Height="10" Margin="10,0"/>
                    -->
                </StackPanel>

                <!-- 版本+时间 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 8 0 10">
                    <TextBlock Text="{Binding ShortVersion, Mode=OneWay}"
                               ToolTip="{Binding FullVersion, Mode=OneWay}"
                               Foreground="#95A5A6" FontSize="12" Margin="0,0,20,0"
                               Cursor="Help"/>
                    <TextBlock Text="{Binding CurrentTime, Mode=OneWay}"
                               Foreground="White" FontSize="12" Margin="0 0 10 0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
