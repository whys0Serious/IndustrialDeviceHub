<controls:CustomWindow x:Class="DeviceHub.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceHub.Client"
        xmlns:controls="clr-namespace:DeviceHub.Client.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1200"
        Background="{DynamicResource BackgroundBrush}"
        xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- 左侧菜单 -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <StackPanel Margin="10">
                <TextBlock Text="设备中枢" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource SidebarTextBrush}"
                           Margin="0,20,0,30" HorizontalAlignment="Center"/>
                <!--加新页面 -->
                <Button Content="设备管理" Height="40" Margin="0,5"
                         Background="{DynamicResource SidebarItemActiveBrush}"
                         Foreground="{DynamicResource SidebarTextBrush}" BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding NavigateToDeviceListCommand}"/>
            </StackPanel>
        </Border>

        <!--右侧根据 CurrentViewModel自动找DataTemplate-->
        <ContentControl Grid.Column="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" 
                        Content="{Binding CurrentViewModel}"/>
        <!-- 全局状态栏 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--服务状态区（M3填 Modbus，M6 填 AI）-->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 占位：M3 加 Modbus 状态，M6 加 AI 状态 -->
                </StackPanel>

                <!-- 后台任务区（M4 填导入进度等） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 占位-->
                    <!-- 
                    <TextBlock Text="正在导入知识库..." Foreground="White" FontSize="12"/>
                    <ProgressBar Value="45" Width="100" Height="10" Margin="10,0"/>
                    -->
                </StackPanel>

                <!-- 版本+时间 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 8 0 10">
                    <TextBlock Text="{Binding ShortVersion, Mode=OneWay}"
                               ToolTip="{Binding FullVersion, Mode=OneWay}"
                               Foreground="{DynamicResource SidebarTextSecondaryBrush}"
                               FontSize="12" Margin="0,0,20,0"
                               Cursor="Help"/>
                    <TextBlock Text="{Binding CurrentTime, Mode=OneWay}"
                               Foreground="{DynamicResource SidebarTextBrush}"
                               FontSize="12" Margin="0 0 10 0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</controls:CustomWindow>
