<UserControl
    x:Class="DeviceHub.Client.Views.RealtimeMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,30,0"
                VerticalAlignment="Center"
                FontSize="{DynamicResource FontSizeTitle}"
                FontWeight="Bold"
                Text="实时监控" />
            <TextBlock
                Grid.Column="1"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="设备：" />
            <ComboBox
                Grid.Column="2"
                Width="250"
                Height="32"
                VerticalAlignment="Center"
                DisplayMemberPath="Name"
                ItemsSource="{Binding DeviceOptions}"
                SelectedItem="{Binding SelectedDevice}" />
            <controls:DeviceStatusIndicator
                Grid.Column="3"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                DotSize="16"
                Status="{Binding SelectedDevice.Status}" />
            <TextBlock
                Grid.Column="4"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Foreground="Red"
                Text="{Binding ErrorMessage}" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  温度波形球  -->
            <Border
                Grid.Column="0"
                Margin="0,0,20,0"
                Padding="20"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,25"
                        HorizontalAlignment="Center"
                        FontSize="{DynamicResource FontSizeLarge}"
                        FontWeight="SemiBold"
                        Text="温度" />
                    <hc:WaveProgressBar
                        Width="160"
                        Height="160"
                        HorizontalAlignment="Center"
                        BorderThickness="0"
                        Maximum="{Binding TemperatureMax}"
                        ShowText="True"
                        Text="{Binding Temperature, StringFormat={}{0:F1}℃}"
                        Value="{Binding Temperature}" />

                    <TextBlock
                        Margin="0,15,0,0"
                        HorizontalAlignment="Center"
                        Text="{Binding Temperature, StringFormat=当前 {0:F1} ℃}" />
                </StackPanel>
            </Border>

            <!--  压力 + 转速曲线  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  压力曲线  -->
                <Border
                    Grid.Row="0"
                    Padding="15"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="{DynamicResource FontSizeLarge}"
                                FontWeight="SemiBold"
                                Text="压力" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding CurrentPressure, StringFormat={}  {0:F0} kPa}" />
                        </StackPanel>

                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{Binding PressureSeries}"
                            TooltipPosition="Top"
                            XAxes="{Binding PressureXAxes}"
                            YAxes="{Binding PressureYAxes}" />
                    </Grid>
                </Border>

                <!--  转速曲线  -->
                <Border
                    Grid.Row="2"
                    Padding="15"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="{DynamicResource FontSizeLarge}"
                                FontWeight="SemiBold"
                                Text="转速" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding CurrentSpeed, StringFormat={}  {0} RPM}" />
                        </StackPanel>

                        <lvc:CartesianChart
                            Grid.Row="1"
                            Series="{Binding SpeedSeries}"
                            TooltipPosition="Top"
                            XAxes="{Binding SpeedXAxes}"
                            YAxes="{Binding SpeedYAxes}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  底部状态  -->
        <Border
            Grid.Row="2"
            Margin="0,20,0,0"
            Padding="15,10"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#E74C3C" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#27AE60" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding ConnectionText}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding LastUpdateTime, StringFormat=最后更新：{0:HH:mm:ss}, TargetNullValue=等待数据...}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
