<UserControl x:Class="DeviceHub.Client.Views.RealtimeMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeviceHub.Client.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="实时监控" FontSize="24" FontWeight="Bold"
               VerticalAlignment="Center" Margin="0,0,30,0"/>
            <TextBlock Grid.Column="1" Text="设备：" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox Grid.Column="2"
              ItemsSource="{Binding DeviceOptions}"
              SelectedItem="{Binding SelectedDevice}"
              DisplayMemberPath="Name"
              Width="250" Height="32"
              VerticalAlignment="Center"/>

            <TextBlock Grid.Column="3"
               Text="{Binding ErrorMessage}"
               Foreground="Red"
               VerticalAlignment="Center"
               Margin="20,0,0,0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 温度波形球 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6" Padding="20" Margin="0,0,20,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="温度" HorizontalAlignment="Center"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,15"/>

                    <hc:WaveProgressBar Width="160" Height="160"
                        HorizontalAlignment="Center"
                        Maximum="{Binding TemperatureMax}"
                        Value="{Binding Temperature}"
                        ShowText="True"
                        Text="{Binding Temperature, StringFormat={}{0:F1}℃}"
                        BorderThickness="0"/>

                    <TextBlock Text="{Binding Temperature, StringFormat=当前 {0:F1} ℃}"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

            <!--压力 + 转速曲线 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 压力曲线 -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="压力" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CurrentPressure, StringFormat={}  {0:F0} kPa}"
                       FontSize="14" Foreground="{DynamicResource PrimaryBrush}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <lvc:CartesianChart Grid.Row="1"
                            Series="{Binding PressureSeries}"
                            XAxes="{Binding PressureXAxes}"
                            YAxes="{Binding PressureYAxes}"
                            TooltipPosition="Top"/>
                    </Grid>
                </Border>

                <!-- 转速曲线 -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="转速" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CurrentSpeed, StringFormat={}  {0} RPM}"
                       FontSize="14" Foreground="{DynamicResource PrimaryBrush}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <lvc:CartesianChart Grid.Row="1"
                            Series="{Binding SpeedSeries}"
                            XAxes="{Binding SpeedXAxes}"
                            YAxes="{Binding SpeedYAxes}"
                            TooltipPosition="Top"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部状态 -->
        <Border Grid.Row="2" Margin="0,20,0,0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#E74C3C"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#27AE60"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding LastUpdateTime, StringFormat=最后更新：{0:HH:mm:ss}, TargetNullValue=等待数据...}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
