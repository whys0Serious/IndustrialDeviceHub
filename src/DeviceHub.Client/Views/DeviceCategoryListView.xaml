<UserControl
    x:Class="DeviceHub.Client.Views.DeviceCategoryListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="22"
            FontWeight="Bold"
            Text="分类管理" />

        <!--  工具栏  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.05"
                    ShadowDepth="1"
                    Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="Red"
                    Text="{Binding ErrorMessage}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="0,0,5,0"
                        Command="{Binding LoadCommand}"
                        Content="刷新" />
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="0,0,5,0"
                        Background="{DynamicResource PrimaryBrush}"
                        BorderThickness="0"
                        Command="{Binding CreateCommand}"
                        Content="+ 新增"
                        Foreground="{DynamicResource SidebarTextBrush}" />
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="0,0,5,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Command="{Binding EditCommand}"
                        Content="✎ 编辑"
                        Foreground="{DynamicResource PrimaryBrush}" />
                    <Button
                        Height="30"
                        MinWidth="80"
                        Command="{Binding DeleteCommand}"
                        Content="🗑 删除"
                        Style="{DynamicResource ButtonDanger}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  DataGrid  -->
        <Grid Grid.Row="2">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="Gray"
                Text="暂无分类，点击「+ 新增」创建">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DataGrid
                AutoGenerateColumns="False"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="1"
                CanUserAddRows="False"
                CanUserResizeColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Categories}"
                RowHeight="35"
                SelectedItem="{Binding SelectedCategory}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Id}"
                        Header="Id" />
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Name}"
                        Header="分类名称" />
                    <DataGridTemplateColumn
                        Width="*"
                        CanUserSort="False"
                        Header="描述">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <TextBlock
                                            MaxWidth="200"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding DeviceCount}"
                        Header="设备数量" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
