<controls:CustomWindow x:Class="DeviceHub.Client.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceHub.Client.Views"
        xmlns:controls="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
        xmlns:hc="https://handyorg.github.io/handycontrol"              
        mc:Ignorable="d"
        Title="登录 - IndustrialDeviceHub"
                       Height="400" Width="420"
                       WindowStartupLocation="CenterScreen"
                       ResizeMode="NoResize"
                       ShowInTaskbar="True"
                       ShowMinimize="False"
                       ShowMaximize="False">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,30">
            <TextBlock Text="IndustrialDeviceHub"
                       FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock Text="工业设备监控与运维管理平台"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 用户名 -->
        <TextBlock Grid.Row="1" Text="用户名" FontSize="13" Margin="0,0,0,6"/>
        <TextBox Grid.Row="2"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Height="36" VerticalContentAlignment="Center"
                 Padding="8,0" Margin="0,0,0,15"/>

        <!-- 密码 -->
        <TextBlock Grid.Row="3" Text="密码" FontSize="13" Margin="0,0,0,6"/>
        <PasswordBox 
               Grid.Row="4"
               IsEnabled="True"
               x:Name="PasswordInput"
               Height="36" VerticalContentAlignment="Center"
               Padding="8,0"/>
            <!-- 错误提示 -->
        <TextBlock Grid.Row="5"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="0,12,0,0"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消"
                    Command="{Binding CancelCommand}"
                    MinWidth="80" Height="34" Margin="0,0,10,0"/>
            <Button Content="登 录"
                    Command="{Binding LoginCommand}"
                    MinWidth="100" Height="34"
                    IsDefault="True"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource LightPrimaryBrush}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</controls:CustomWindow>
