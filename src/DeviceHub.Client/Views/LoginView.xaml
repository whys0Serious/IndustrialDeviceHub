<controls:CustomWindow
    x:Class="DeviceHub.Client.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="登录"
    Width="380"
    Height="360"
    IsDialog="True"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    ShowMaximize="False"
    ShowMinimize="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="20,10,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,10,0,30"
            HorizontalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="{DynamicResource FontSizeTitle}"
                FontWeight="Bold"
                Foreground="{DynamicResource PrimaryBrush}"
                Text="工业设备监控与运维管理平台" />
            <TextBlock
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="IndustrialDeviceHub" />
        </StackPanel>

        <!--  用户名  -->
        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,6"
            FontSize="13"
            Text="用户名" />
        <TextBox
            Grid.Row="2"
            Height="36"
            Margin="0,0,0,15"
            Padding="8,0"
            VerticalContentAlignment="Center"
            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

        <!--  密码  -->
        <TextBlock
            Grid.Row="3"
            Margin="0,0,0,6"
            FontSize="13"
            Text="密码" />
        <PasswordBox
            x:Name="PasswordInput"
            Grid.Row="4"
            Height="36"
            Padding="8,0"
            VerticalContentAlignment="Center"
            IsEnabled="True" />
        <!--  错误提示  -->
        <TextBlock
            Grid.Row="5"
            Margin="0,12,0,0"
            VerticalAlignment="Top"
            FontSize="12"
            Foreground="{DynamicResource DangerBrush}"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap" />

        <!--  按钮  -->
        <StackPanel
            Grid.Row="6"
            Margin="0,0,0,10"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Height="34"
                MinWidth="80"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Content="取消" />
            <Button
                Height="34"
                MinWidth="100"
                Background="{DynamicResource PrimaryBrush}"
                BorderThickness="0"
                Command="{Binding LoginCommand}"
                Content="登 录"
                Foreground="{DynamicResource LightPrimaryBrush}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</controls:CustomWindow>
