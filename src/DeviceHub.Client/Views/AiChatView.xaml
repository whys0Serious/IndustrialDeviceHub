<UserControl
    x:Class="DeviceHub.Client.Views.AiChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="{DynamicResource FontSizeTitle}"
            FontWeight="Bold"
            Text="AI 助手" />

        <!--  输入区  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="输入故障描述：" />

                <TextBox
                    Grid.Row="1"
                    Height="80"
                    Margin="0,0,0,10"
                    Padding="8"
                    VerticalContentAlignment="Top"
                    AcceptsReturn="True"
                    Text="{Binding FaultDescription, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="Red"
                        Text="{Binding ErrorMessage}" />

                    <Button
                        Grid.Column="1"
                        Height="32"
                        MinWidth="80"
                        Margin="0,0,10,0"
                        Command="{Binding ClearCommand}"
                        Content="清空" />

                    <Button
                        Grid.Column="2"
                        Height="32"
                        MinWidth="100"
                        Background="{DynamicResource PrimaryBrush}"
                        BorderThickness="0"
                        Command="{Binding DiagnoseCommand}"
                        Content="🔍 诊断"
                        Foreground="White" />
                </Grid>
            </Grid>
        </Border>

        <!--  结果区  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  加载中  -->
                <TextBlock
                    Margin="0,20"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="Gray"
                    Text="正在诊断中..."
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                <!--  AI 建议  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="6"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="💡 AI 建议" />
                        <TextBlock
                            FontSize="13"
                            LineHeight="22"
                            Text="{Binding Suggestion}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  相似案例  -->
                <StackPanel Visibility="{Binding HasSimilarCases, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="📋 相似历史案例" />

                    <ItemsControl ItemsSource="{Binding SimilarCases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="15"
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                Text="{Binding OrderNo}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="15,0"
                                                FontSize="13"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="{Binding Similarity, StringFormat=相似度 {0:P0}}" />
                                        </Grid>

                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource SuccessBrush}"
                                            Text="{Binding Resolution, StringFormat=处理：{0}}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
