<controls:CustomWindow
    x:Class="DeviceHub.Client.Views.RecipeEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="RecipeEditView"
    Width="480"
    Height="360"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  配方名称  -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,10,15"
                VerticalAlignment="Center"
                Text="配方名称 *" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Height="32"
                Margin="0,0,0,15"
                VerticalContentAlignment="Center"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <!--  目标温度  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,10,15"
                VerticalAlignment="Center"
                Text="目标温度 (℃) *" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Height="32"
                Margin="0,0,0,15"
                VerticalContentAlignment="Center"
                Text="{Binding TargetTemperature, UpdateSourceTrigger=PropertyChanged}" />

            <!--  目标压力  -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,10,15"
                VerticalAlignment="Center"
                Text="目标压力 (kPa) *" />
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Height="32"
                Margin="0,0,0,15"
                VerticalContentAlignment="Center"
                Text="{Binding TargetPressure, UpdateSourceTrigger=PropertyChanged}" />

            <!--  目标转速  -->
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="目标转速 (RPM) *" />
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Height="32"
                Margin="0,0,0,15"
                VerticalContentAlignment="Center"
                Text="{Binding TargetSpeed, UpdateSourceTrigger=PropertyChanged}" />

            <!--  错误提示区  -->
            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                MinHeight="20"
                VerticalAlignment="Top"
                Foreground="{DynamicResource DangerBrush}"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap" />
        </Grid>

        <!--  底部按钮  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,15,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Height="32"
                Margin="0,0,10,0"
                Background="{DynamicResource PrimaryBrush}"
                BorderThickness="0"
                Command="{Binding SaveCommand}"
                Content="保存"
                Foreground="White"
                IsDefault="True" />
            <Button
                Width="90"
                Height="32"
                Command="{Binding CancelCommand}"
                Content="取消"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</controls:CustomWindow>
