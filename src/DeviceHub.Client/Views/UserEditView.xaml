<controls:CustomWindow x:Class="DeviceHub.Client.Views.UserEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceHub.Client.Views"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        xmlns:controls="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
        Title="{Binding Title}"
        Height="420" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowMinimize="False"
        ShowMaximize="False"
        IsDialog="True"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="用户名 *" VerticalAlignment="Center" Margin="0,0,10,15"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditUsername}"
                     Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="密码 *" VerticalAlignment="Center" Margin="0,0,10,15"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                     Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="显示名 *" VerticalAlignment="Center" Margin="0,0,10,15"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                     Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="角色 *" VerticalAlignment="Center" Margin="0,0,10,15"/>
            <ComboBox Grid.Row="3" Grid.Column="1"
                      ItemsSource="{Binding RoleOptions}"
                      SelectedItem="{Binding SelectedRole}"
                      DisplayMemberPath="Display"
                      Height="32" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="保存" Command="{Binding SaveCommand}"
                    Width="90" Height="32" Margin="0,0,10,0" IsDefault="True"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource LightPrimaryBrush}" BorderThickness="0"/>
            <Button Content="取消" Command="{Binding CancelCommand}"
                    Width="90" Height="32" IsCancel="True"/>
        </StackPanel>
    </Grid>
</controls:CustomWindow>
