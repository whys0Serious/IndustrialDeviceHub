<UserControl x:Class="DeviceHub.Client.Views.AlarmBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DeviceHub.Client.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             Visibility="{Binding HasAlarms, Converter={StaticResource BoolToVisibility}}">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="⚠"
                   FontSize="13"
                   Foreground="#FBBF24"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0"/>
        <TextBlock Text="{Binding StatusMessage}"
                   FontSize="12"
                   Foreground="#FBBF24"
                   VerticalAlignment="Center"
                   Margin="0,0,15,0"/>
        <TextBlock Text="{Binding FirstAlarmMessage, TargetNullValue=''}"
                   FontSize="12"
                   Foreground="#FFD591"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="500"/>
        <Button Content="查看"
                Command="{Binding ViewAlarmsCommand}"
                Background="Transparent"
                Foreground="#1890FF"
                BorderThickness="0"
                Cursor="Hand"
                FontSize="12"
                Margin="10,0,0,0"
                Padding="4,0"/>
    </StackPanel>
</UserControl>
