<UserControl
    x:Class="DeviceHub.Client.Views.JobHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="{DynamicResource FontSizeTitle}"
            FontWeight="Bold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="加工履历" />
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="8">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    Height="32"
                    Command="{Binding RefreshCommand}"
                    Content="刷新记录"
                    Style="{StaticResource ButtonDefault}" />
                <Button
                    Width="110"
                    Height="32"
                    Margin="10,0,0,0"
                    Command="{Binding ExportReportCommand}"
                    Content="📄 导出报告"
                    Style="{StaticResource ButtonPrimary}" />
            </StackPanel>
        </Border>

        <!--  数据列表  -->
        <Border
            Grid.Row="2"
            Padding="1"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.05"
                    ShadowDepth="1"
                    Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <!--  上半部分：数据展示区  -->
                    <RowDefinition Height="Auto" />
                    <!--  下半部分：分页统计区  -->
                </Grid.RowDefinitions>
                <DataGrid
                    AutoGenerateColumns="False"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    CanUserResizeColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding JobRecords}"
                    RowHeaderWidth="0"
                    RowHeight="35"
                    SelectedItem="{Binding SelectedJob}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding JobNo}"
                            Header="作业流水号" />
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding RecipeName}"
                            Header="执行配方" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding StartTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                            Header="开始时间" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding AvgTemp, StringFormat='{}{0:F1}'}"
                            Header="均温 (℃)" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding MaxPress, StringFormat='{}{0:F0}'}"
                            Header="极压 (kPa)" />
                        <DataGridTemplateColumn Width="100" Header="综合判定">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="未判定" />
                                                <Setter Property="Foreground" Value="Gray" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsQualified}" Value="True">
                                                        <Setter Property="Text" Value="✅ 合格" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding IsQualified}" Value="False">
                                                        <Setter Property="Text" Value="❌ 不合格" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding EndTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                            Header="结束时间" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border
                    Grid.Row="1"
                    Padding="16,10"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <!--  统计数据  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="Gray">
                            <Run Text="共 " />
                            <Run
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding TotalCount}" />
                            <Run Text=" 条作业记录" />
                        </TextBlock>
                        <hc:Pagination
                            HorizontalAlignment="Right"
                            DataCountPerPage="{Binding PageSize}"
                            IsJumpEnabled="True"
                            MaxPageCount="{Binding TotalPages}"
                            PageIndex="{Binding CurrentPageIndex, Mode=TwoWay}">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="PageUpdated">
                                    <hc:EventToCommand Command="{Binding PageUpdatedCommand}" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:Pagination>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
