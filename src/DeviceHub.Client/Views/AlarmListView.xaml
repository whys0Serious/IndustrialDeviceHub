<UserControl
    x:Class="DeviceHub.Client.Views.AlarmListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="{DynamicResource FontSizeTitle}"
            FontWeight="Bold"
            Text="报警列表" />

        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.05"
                    ShadowDepth="1"
                    Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Text="状态：" />
                    <ComboBox
                        Width="150"
                        Height="30"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding SelectedStatus}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="15,0,5,0"
                        VerticalAlignment="Center"
                        Text="类型：" />
                    <ComboBox
                        Width="150"
                        Height="30"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding TypeOptions}"
                        SelectedItem="{Binding SelectedType}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource DangerBrush}"
                    Text="{Binding ErrorMessage}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button
                        Height="30"
                        MinWidth="70"
                        Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}"
                        Content="重置" />
                    <Button
                        Height="30"
                        MinWidth="70"
                        Background="{DynamicResource PrimaryBrush}"
                        BorderThickness="0"
                        Command="{Binding AcknowledgeCommand}"
                        Content="确认"
                        Foreground="{DynamicResource BorderLightBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="Gray"
                Text="暂无报警记录">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding HasData}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DataGrid
                AutoGenerateColumns="False"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="1"
                CanUserAddRows="False"
                CanUserResizeColumns="False"
                CanUserSortColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Alarms}"
                RowHeight="35"
                SelectedItem="{Binding SelectedAlarm}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Id}"
                        Header="Id" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                        Header="时间" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding DeviceNameDisplay}"
                        Header="设备" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding TypeText}"
                        Header="类型" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Message}"
                        Header="消息" />
                    <DataGridTemplateColumn
                        Width="100"
                        CanUserResize="False"
                        Header="状态">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding AcknowledgedBy}"
                        Header="确认人" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="共" />
                <Run FontWeight="Bold" Text="{Binding TotalCount, Mode=OneWay}" />
                <Run Text="条报警" />
            </TextBlock>

            <hc:Pagination
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                DataCountPerPage="{Binding PageSize}"
                IsJumpEnabled="True"
                MaxPageCount="{Binding TotalPages}"
                PageIndex="{Binding CurrentPageIndex, Mode=TwoWay}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PageUpdated">
                        <hc:EventToCommand Command="{Binding PageUpdatedCommand}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </hc:Pagination>
        </Grid>
    </Grid>
</UserControl>
