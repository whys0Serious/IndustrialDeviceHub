<controls:CustomWindow x:Class="DeviceHub.Client.Views.WorkOrderDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceHub.Client.Views"
        xmlns:controls="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
        mc:Ignorable="d"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="工单详情" 
        Height="640" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowMinimize="False"
        ShowMaximize="False">
    <Grid Margin="20">
        <!-- 加载中 -->
        <TextBlock Text="加载中..."
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="16" Foreground="Gray"
               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        <Grid Visibility="{Binding HasOrder, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 步骤条 -->
                <RowDefinition Height="*"/>
                <!-- 内容 -->
                <RowDefinition Height="Auto"/>
                <!-- 按钮 -->
            </Grid.RowDefinitions>

            <!-- 步骤条 -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6" Padding="30,20" Margin="0,0,0,15">
                <hc:StepBar StepIndex="{Binding CurrentStep, Mode=OneWay}">
                    <hc:StepBarItem Content="待处理"/>
                    <hc:StepBarItem Content="处理中"/>
                    <hc:StepBarItem Content="已关闭"/>
                </hc:StepBar>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 基本信息 -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="工单号：" Foreground="Gray"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Order.OrderNo}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="优先级：" Foreground="Gray"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Order.PriorityText}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="设备：" Foreground="Gray"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Order.DeviceNameDisplay}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="状态：" Foreground="Gray"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Order.StatusText}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="创建人：" Foreground="Gray"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Order.CreatedBy}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="创建时间：" Foreground="Gray"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Order.CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="处理人：" Foreground="Gray"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Order.AssignedTo}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="开始时间：" Foreground="Gray"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Order.StartedAt, StringFormat=yyyy-MM-dd HH:mm, TargetNullValue=—}"/>
                        </Grid>
                    </Border>

                    <!-- 标题 + 描述 -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="标题" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Order.Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <TextBlock Text="故障描述" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Order.Description}" TextWrapping="Wrap" FontSize="13" LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <!-- 处理结果（已关闭时显示） -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="20" Margin="0,0,0,15"
                        Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="处理结果" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Order.Resolution}" TextWrapping="Wrap" FontSize="13" LineHeight="22"/>
                            <TextBlock Text="{Binding Order.ClosedAt, StringFormat=关闭时间：yyyy-MM-dd HH:mm}"
                                   Foreground="Gray" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="20">
                        <StackPanel>
                            <TextBlock Text="处理记录" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <ItemsControl ItemsSource="{Binding Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" FontSize="12"/>
                                                <TextBlock Text="{Binding Operator}" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding Remark}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="Gray" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Grid Grid.Row="2" Margin="10,15,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="▶ 开始处理" Command="{Binding StartCommand}"
                        MinWidth="100" Height="32" Margin="0,0,10,0"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White" BorderThickness="0"/>
                    <Button Content="✓ 关闭工单" Command="{Binding CloseCommand}"
                        MinWidth="100" Height="32"
                        Foreground="{DynamicResource DangerBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"/>
                </StackPanel>

                <Button Content="关闭" Command="{Binding CloseDialogCommand}"
                    HorizontalAlignment="Right"
                    MinWidth="90" Height="32" IsCancel="True"/>
            </Grid>
        </Grid>
    </Grid>
</controls:CustomWindow>
