<controls:CustomWindow x:Class="DeviceHub.Client.Views.WorkOrderCloseView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceHub.Client.Views"
        xmlns:controls="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="320" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowMinimize="False"
        ShowMaximize="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 提示 -->
        <TextBlock Grid.Row="0" Margin="0,0,0,15" FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="即将关闭工单："/>
            <Run Text="{Binding OrderTitle, Mode=OneWay}" FontWeight="Bold"/>
        </TextBlock>

        <!-- 处理结果输入 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="处理结果 *" Margin="0,0,0,8"
                       FontSize="13" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1"
                     Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="8"
                     MinHeight="100"/>
        </Grid>

        <!-- 错误提示 -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="确认关闭" Command="{Binding SaveCommand}"
                    Width="100" Height="32" Margin="0,0,10,0" IsDefault="True"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="White" BorderThickness="0"/>
            <Button Content="取消" Command="{Binding CancelCommand}"
                    Width="90" Height="32" IsCancel="True"/>
        </StackPanel>
    </Grid>
</controls:CustomWindow>
