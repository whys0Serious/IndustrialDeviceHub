<UserControl
    x:Class="DeviceHub.Client.Views.JobExecutionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="{DynamicResource FontSizeTitle}"
            FontWeight="Bold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="加工中心" />
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="选择配方：" />
                <ComboBox
                    Width="200"
                    Height="32"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Recipes}"
                    SelectedItem="{Binding SelectedRecipe}" />

                <Button
                    Width="110"
                    Height="32"
                    Margin="15,0,0,0"
                    Command="{Binding StartJobCommand}"
                    Content="🚀 启动作业"
                    Style="{StaticResource ButtonPrimary}" />

                <Button
                    Width="80"
                    Height="32"
                    Margin="10,0,0,0"
                    Command="{Binding ResetCommand}"
                    Content="重置">
                    <Button.Style>
                        <Style BasedOn="{StaticResource ButtonDefault}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="Gray"
                    Text="{Binding StatusMessage}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <!--  参数预览面板  -->
            <Border
                Padding="20"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConfiguring}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="【当前配方参数预览】" />
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="14"
                        Text="{Binding SelectedRecipe.TargetTemperature, StringFormat='目标温度：{0} ℃'}" />
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="14"
                        Text="{Binding SelectedRecipe.TargetPressure, StringFormat='目标压力：{0} kPa'}" />
                    <TextBlock FontSize="14" Text="{Binding SelectedRecipe.TargetSpeed, StringFormat='目标转速：{0} RPM'}" />
                </StackPanel>
            </Border>

            <!--  运行监控面板  -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar
                    Height="24"
                    Margin="0,0,0,30"
                    Maximum="100"
                    Value="{Binding Progress}" />

                <UniformGrid Margin="0,0,0,20" Columns="3">
                    <Border
                        Margin="10"
                        Padding="20"
                        Background="{DynamicResource RegionBrush}"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                Foreground="Gray"
                                Text="实时温度 (℃)" />
                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding CurrentTemp, StringFormat='{}{0:F1}'}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="10"
                        Padding="20"
                        Background="{DynamicResource RegionBrush}"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                Foreground="Gray"
                                Text="实时压力 (kPa)" />
                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding CurrentPress, StringFormat='{}{0:F0}'}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="10"
                        Padding="20"
                        Background="{DynamicResource RegionBrush}"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                Foreground="Gray"
                                Text="实时转速 (RPM)" />
                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding CurrentSpeed, StringFormat='{}{0:F0}'}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!--  3. 结果面板  -->
            <Border
                Padding="20"
                Background="{DynamicResource RegionBrush}"
                CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="【综合测试结果】" />
                    <TextBlock
                        FontSize="16"
                        LineHeight="30"
                        Text="{Binding ResultSummary}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>