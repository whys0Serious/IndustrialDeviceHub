<UserControl
    x:Class="DeviceHub.Client.Views.UserListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="{DynamicResource FontSizeTitle}"
            FontWeight="Bold"
            Text="用户管理" />

        <!--  工具栏  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.05"
                    ShadowDepth="1"
                    Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="Red"
                    Text="{Binding ErrorMessage}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Height="30"
                        MinWidth="70"
                        Margin="0,0,8,0"
                        Command="{Binding LoadCommand}"
                        Content="刷新" />
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="0,0,8,0"
                        Background="{DynamicResource PrimaryBrush}"
                        BorderThickness="0"
                        Command="{Binding CreateCommand}"
                        Content="+ 新增"
                        Foreground="White" />
                    <Button
                        Height="30"
                        MinWidth="70"
                        Margin="0,0,8,0"
                        Command="{Binding EditCommand}"
                        Content="✎ 编辑" />
                    <Button
                        Height="30"
                        MinWidth="90"
                        Command="{Binding ToggleActiveCommand}"
                        Content="启用/禁用" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  列表  -->
        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1"
            CanUserAddRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding Users}"
            RowHeight="35"
            SelectedItem="{Binding SelectedUser}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Id}"
                    Header="Id" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Username}"
                    Header="用户名" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding DisplayName}"
                    Header="显示名" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding RoleText}"
                    Header="角色" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding ActiveText}"
                    Header="状态" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                    Header="创建时间" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding LastLoginAt, StringFormat=yyyy-MM-dd HH:mm, TargetNullValue=—}"
                    Header="最后登录" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
