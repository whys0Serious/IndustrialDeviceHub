<UserControl
    x:Class="DeviceHub.Client.Views.WorkOrderListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,15"
            FontSize="24"
            FontWeight="Bold"
            Text="工单列表" />
        <!--  工具栏  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Padding="12"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <hc:SearchBar
                    Grid.Column="0"
                    Width="140"
                    Height="30"
                    Margin="0,0,10,0"
                    hc:InfoElement.ShowClearButton="True"
                    hc:InfoElement.Title="关键字："
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="60"
                    Command="{Binding SearchCommand}"
                    Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Text="状态：" />
                    <ComboBox
                        Width="80"
                        Height="30"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding SelectedStatus}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Text="优先级：" />
                    <ComboBox
                        Width="80"
                        Height="30"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding PriorityOptions}"
                        SelectedItem="{Binding SelectedPriority}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="3"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Text="设备：" />
                    <ComboBox
                        Width="140"
                        Height="30"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding DeviceOptions}"
                        SelectedItem="{Binding SelectedDevice}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="Red"
                    Text="{Binding ErrorMessage}" />

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button
                        Height="30"
                        MinWidth="70"
                        Margin="0,0,8,0"
                        Command="{Binding ResetCommand}"
                        Content="重置" />
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="0,0,8,0"
                        Background="{DynamicResource PrimaryBrush}"
                        BorderThickness="0"
                        Command="{Binding CreateCommand}"
                        Content="+ 新增"
                        Foreground="White" />
                    <Button
                        Height="30"
                        MinWidth="70"
                        Margin="0,0,8,0"
                        Command="{Binding EditCommand}"
                        Content="✎ 编辑" />
                    <Button
                        Height="30"
                        MinWidth="70"
                        Command="{Binding ViewDetailCommand}"
                        Content="📋 详情" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  DataGrid  -->
        <Grid Grid.Row="2">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="Gray"
                Text="暂无工单">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding HasData}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DataGrid
                AutoGenerateColumns="False"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="1"
                CanUserAddRows="False"
                CanUserResizeColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding WorkOrders}"
                RowHeight="35"
                SelectedItem="{Binding SelectedWorkOrder}">
                <DataGrid.InputBindings>
                    <MouseBinding Command="{Binding ViewDetailCommand}" MouseAction="LeftDoubleClick" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="50"
                        Binding="{Binding Id}"
                        Header="Id" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding OrderNo}"
                        Header="工单号" />
                    <DataGridTemplateColumn
                        Width="*"
                        CanUserSort="False"
                        Header="标题">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <TextBlock
                                            MaxWidth="200"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding DeviceNameDisplay}"
                        Header="设备" />


                    <DataGridTemplateColumn
                        Width="70"
                        CanUserResize="False"
                        Header="优先级">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{Binding PriorityText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Priority}" Value="High">
                                                    <Setter Property="Foreground" Value="#FAAD14" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                                    <Setter Property="Foreground" Value="#E74C3C" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  状态  -->
                    <DataGridTemplateColumn
                        Width="70"
                        CanUserResize="False"
                        Header="状态">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{Binding StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FAAD14" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                    <Setter Property="Foreground" Value="#1890FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                    <Setter Property="Foreground" Value="#27AE60" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding AssignedTo}"
                        Header="处理人" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding CreatedBy}"
                        Header="创建人" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                        Header="创建时间" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!--  分页  -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="共" />
                <Run FontWeight="Bold" Text="{Binding TotalCount, Mode=OneWay}" />
                <Run Text="条工单" />
            </TextBlock>
            <hc:Pagination
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                DataCountPerPage="{Binding PageSize}"
                IsJumpEnabled="True"
                MaxPageCount="{Binding TotalPages}"
                PageIndex="{Binding CurrentPageIndex, Mode=TwoWay}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PageUpdated">
                        <hc:EventToCommand Command="{Binding PageUpdatedCommand}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </hc:Pagination>
        </Grid>
    </Grid>
</UserControl>
