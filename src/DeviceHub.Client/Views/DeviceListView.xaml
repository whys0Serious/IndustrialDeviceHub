<UserControl
    x:Class="DeviceHub.Client.Views.DeviceListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DeviceHub.Controls.Controls;assembly=DeviceHub.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceHub.Client.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  标题  -->
            <RowDefinition Height="Auto" />
            <!--  搜索栏卡片  -->
            <RowDefinition Height="*" />
            <!--  表格卡片  -->
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="{DynamicResource FontSizeTitle}"
            FontWeight="Bold"
            Foreground="{DynamicResource TextPrimaryBrush}"
            Text="设备列表" />
        <!--  工具栏  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,10"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.05"
                    ShadowDepth="1"
                    Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <!--  搜索框  -->
                    <ColumnDefinition Width="0.7*" MinWidth="200" />
                    <!--  状态  -->
                    <ColumnDefinition Width="0.5*" MinWidth="100" />
                    <!--  分类  -->
                    <ColumnDefinition Width="0.5*" MinWidth="120" />
                    <!--  右侧按钮组  -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  搜索框  -->
                <hc:SearchBar
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    hc:InfoElement.ShowClearButton="True"
                    hc:InfoElement.Title="关键字："
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="65"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource SearchBarExtend}"
                    Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                    TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />

                <!--  状态筛选  -->
                <Grid Grid.Column="1" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Text="状态：" />
                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding SelectedStatus}" />
                </Grid>

                <!--  分类筛选  -->
                <Grid Grid.Column="2" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Text="分类：" />
                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding CategoryOptions}"
                        SelectedItem="{Binding SelectedCategory}" />
                </Grid>

                <!--  右侧操作按钮  -->
                <StackPanel
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  重置按钮  -->
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Command="{Binding ResetCommand}"
                        Content="刷新"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="0,0,5,0"
                        Background="{DynamicResource PrimaryBrush}"
                        Command="{Binding CreateCommand}"
                        Content="+ 新增"
                        Foreground="{DynamicResource SidebarTextBrush}" />
                    <Button
                        Height="30"
                        MinWidth="80"
                        Margin="0,0,5,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Command="{Binding EditCommand}"
                        Content="✎ 编辑"
                        Foreground="{DynamicResource PrimaryBrush}" />
                    <Button
                        Height="30"
                        MinWidth="80"
                        BorderThickness="1"
                        Command="{Binding DeleteCommand}"
                        Content="🗑 删除"
                        Style="{DynamicResource ButtonDanger}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  数据  -->
        <Border
            Grid.Row="2"
            Padding="1"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.05"
                    ShadowDepth="1"
                    Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <!--  上半部分：数据展示区  -->
                    <RowDefinition Height="Auto" />
                    <!--  下半部分：分页统计区  -->
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <!--  统计 + 分页  -->
                    </Grid.RowDefinitions>
                    <!--  DataGrid  -->
                    <DataGrid
                        Grid.Row="0"
                        AutoGenerateColumns="False"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserResizeColumns="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Devices}"
                        RowHeight="35"
                        SelectedItem="{Binding SelectedDevice}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding Id}"
                                Header="Id" />
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Name}"
                                Header="设备名称" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Code}"
                                Header="设备编号" />
                            <DataGridTemplateColumn Width="100" Header="状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:DeviceStatusIndicator
                                            Width="40"
                                            Height="30"
                                            HorizontalAlignment="Left"
                                            DotSize="20"
                                            Status="{Binding Status}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding CategoryName}"
                                Header="分类" />
                            <DataGridTemplateColumn
                                Width="*"
                                CanUserSort="False"
                                Header="备注">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Remark}"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.ToolTip>
                                                <TextBlock
                                                    MaxWidth="200"
                                                    Text="{Binding Remark}"
                                                    TextWrapping="Wrap" />
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                Header="创建时间" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <!--  加载中  -->
                    <hc:LoadingCircle
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource LoadingCircleLight}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <!--  空数据  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="Gray"
                        Text="暂无数据">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLoading}" Value="False" />
                                            <Condition Binding="{Binding HasData}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!--  左统计 + 右分页  -->
                    <Border
                        Grid.Row="1"
                        Padding="16,10"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <!--  左侧统计  -->
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--  左：状态统计  -->
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center">
                                            <Run
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                Text="总数：" />
                                            <Run
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                Text="{Binding TotalDevices, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Margin="15,0,0,0" VerticalAlignment="Center">
                                            <Run Foreground="{DynamicResource TextSecondaryBrush}" Text="运行中：" />
                                            <Run
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource SuccessBrush}"
                                                Text="{Binding RunningCount, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Margin="15,0,0,0" VerticalAlignment="Center">
                                            <Run Foreground="{DynamicResource TextSecondaryBrush}" Text="报警：" />
                                            <Run
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Text="{Binding AlarmCount, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Margin="15,0,0,0" VerticalAlignment="Center">
                                            <Run Foreground="{DynamicResource TextSecondaryBrush}" Text="停止：" />
                                            <Run
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextDisabledBrush}"
                                                Text="{Binding StoppedCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <!--  中：错误提示  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Text="{Binding ErrorMessage}" />
                                </Grid>
                            </StackPanel>
                            <!--  分页  -->
                            <hc:Pagination
                                Grid.Row="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                DataCountPerPage="{Binding PageSize}"
                                IsJumpEnabled="True"
                                MaxPageCount="{Binding TotalPages}"
                                PageIndex="{Binding CurrentPageIndex, Mode=TwoWay}">
                                <hc:Interaction.Triggers>
                                    <hc:EventTrigger EventName="PageUpdated">
                                        <hc:EventToCommand Command="{Binding PageUpdatedCommand}" />
                                    </hc:EventTrigger>
                                </hc:Interaction.Triggers>
                            </hc:Pagination>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
