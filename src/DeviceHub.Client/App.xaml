<Application
    x:Class="DeviceHub.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DeviceHub.Client.Converters"
    xmlns:local="clr-namespace:DeviceHub.Client"
    xmlns:views="clr-namespace:DeviceHub.Client.Views"
    xmlns:vm="clr-namespace:DeviceHub.Client.ViewModels"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <!--  项目主题（默认浅色）  -->
                <ResourceDictionary Source="pack://application:,,,/DeviceHub.Client;component/Themes/LightBrushes.xaml" />
                <ResourceDictionary Source="/Themes/CaptionStyles.xaml" />
                <ResourceDictionary Source="/Themes/LightTheme.xaml" />
                <ResourceDictionary Source="/Themes/LightBrushes.xaml" />

                <ResourceDictionary Source="/Themes/Controls.xaml" />
                <ResourceDictionary Source="/Themes/TextStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--  转换器  -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <!--  ViewModel→View 映射 加新页面在这里加一行  -->
            <DataTemplate DataType="{x:Type vm:DeviceListViewModel}">
                <views:DeviceListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeviceCategoryListViewModel}">
                <views:DeviceCategoryListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RealtimeMonitorViewModel}">
                <views:RealtimeMonitorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AlarmListViewModel}">
                <views:AlarmListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WorkOrderListViewModel}">
                <views:WorkOrderListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AiChatViewModel}">
                <views:AiChatView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UserListViewModel}">
                <views:UserListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecipeListViewModel}">
                <views:RecipeListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:JobExecutionViewModel}">
                <views:JobExecutionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:JobHistoryViewModel}">
                <views:JobHistoryView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
