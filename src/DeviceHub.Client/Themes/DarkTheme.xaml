<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 主色 ========== -->
    <Color x:Key="PrimaryColor">#3B82F6</Color>
    <Color x:Key="PrimaryDarkColor">#2563EB</Color>
    <Color x:Key="PrimaryLightColor">#1E3A5F</Color>

    <!-- ========== 状态色 ========== -->
    <Color x:Key="SuccessColor">#4ADE80</Color>
    <Color x:Key="SuccessLightColor">#1A3D2A</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="WarningLightColor">#3D3018</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="DangerDarkColor">#DC2626</Color>
    <Color x:Key="DangerLightColor">#3D1F1F</Color>

    <!-- ========== 中性色 ========== -->
    <Color x:Key="TextPrimaryColor">#E5E9F0</Color>
    <Color x:Key="TextSecondaryColor">#A0A8B8</Color>
    <Color x:Key="TextDisabledColor">#6B7280</Color>
    <Color x:Key="BorderColor">#2D3748</Color>
    <Color x:Key="BorderLightColor">#1F2937</Color>

    <!-- ========== 背景 ========== -->
    <Color x:Key="BackgroundColor">#0F1419</Color>
    <Color x:Key="SurfaceColor">#1A2332</Color>
    <Color x:Key="SurfaceHoverColor">#232F42</Color>
    <Color x:Key="HeaderBackgroundColor">#141B26</Color>

    <!-- ========== 左侧菜单 ========== -->
    <Color x:Key="SidebarBackgroundColor">#0A1018</Color>
    <Color x:Key="SidebarTextColor">#E5E9F0</Color>
    <Color x:Key="SidebarTextSecondaryColor">#7A8597</Color>
    <Color x:Key="SidebarItemHoverColor">#1A2332</Color>
    <Color x:Key="SidebarItemActiveColor">#3B82F6</Color>

    <!-- ========== 标题栏 ========== -->
    <Color x:Key="TitleBarBackgroundColor">#141B26</Color>
    <Color x:Key="TitleBarForegroundColor">#E5E9F0</Color>
    <Color x:Key="TitleBarButtonHoverColor">#232F42</Color>
    <Color x:Key="TitleBarButtonPressedColor">#2D3748</Color>

    <!-- ========== 报警横幅 ========== -->
    <Color x:Key="AlarmBannerColor">#3D3018</Color>
    <Color x:Key="AlarmBannerTextColor">#FBBF24</Color>
    <Color x:Key="AlarmBannerNormalColor">#1A3D2A</Color>
    <Color x:Key="AlarmBannerLightColor">#3D3018</Color>
    <Color x:Key="AlarmDarkColor">#FBBF24</Color>

</ResourceDictionary>