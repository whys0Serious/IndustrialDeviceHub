<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 主色（深色主题下更亮） -->
    <Color x:Key="PrimaryColor">#40A9FF</Color>
    <Color x:Key="PrimaryDarkColor">#1890FF</Color>
    <Color x:Key="PrimaryLightColor">#111D2C</Color>

    <!-- 状态色 -->
    <Color x:Key="SuccessColor">#4ECB71</Color>
    <Color x:Key="WarningColor">#FFB74D</Color>
    <Color x:Key="WarningLightColor">#2B1F0F</Color>
    <Color x:Key="WarningDarkColor">#FFD591</Color>
    <Color x:Key="DangerColor">#FF6B6B</Color>
    <Color x:Key="DangerDarkColor">#D9363E</Color>

    <!-- 中性色 -->
    <Color x:Key="TextPrimaryColor">#E6E6E6</Color>
    <Color x:Key="TextSecondaryColor">#A6A6A6</Color>
    <Color x:Key="TextDisabledColor">#6C6C6C</Color>
    <Color x:Key="BorderColor">#303030</Color>
    <Color x:Key="BorderLightColor">#262626</Color>

    <!-- 背景 -->
    <Color x:Key="BackgroundColor">#141414</Color>
    <Color x:Key="SurfaceColor">#1F1F1F</Color>
    <Color x:Key="SurfaceHoverColor">#262626</Color>
    <Color x:Key="HeaderBackgroundColor">#262626</Color>

    <!-- 左侧菜单 / 状态栏（深色下更黑） -->
    <Color x:Key="SidebarBackgroundColor">#000000</Color>
    <Color x:Key="SidebarTextColor">#E6E6E6</Color>
    <Color x:Key="SidebarTextSecondaryColor">#8C8C8C</Color>
    <Color x:Key="SidebarItemHoverColor">#1F1F1F</Color>
    <Color x:Key="SidebarItemActiveColor">#40A9FF</Color>

    <!-- 标题栏 -->
    <Color x:Key="TitleBarBackgroundColor">#1F1F1F</Color>
    <Color x:Key="TitleBarForegroundColor">#E6E6E6</Color>
    <Color x:Key="TitleBarButtonHoverColor">#2D2D2D</Color>
    <Color x:Key="TitleBarButtonPressedColor">#3D3D3D</Color>
    
    <!--报警横幅-->
    <Color x:Key="AlarmBannerColor">#FAAD14</Color>
    <Color x:Key="AlarmBannerTextColor">#874D00</Color>
    <Color x:Key="AlarmBannerNormalColor">#B7EB8F</Color>
    <Color x:Key="AlarmBannerLightColor">#FFF4E5</Color>
    <Color x:Key="AlarmDarkColor">#FFD591</Color>
</ResourceDictionary>