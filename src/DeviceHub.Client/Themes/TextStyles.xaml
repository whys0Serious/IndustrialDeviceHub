<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--  正文默认  -->
    <sys:Double x:Key="FontSizeBase">14</sys:Double>
    <!--  辅助信息/备注  -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <!--  强调文字/小标题  -->
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <!--  导航大标题  -->
    <sys:Double x:Key="FontSizeTitle">22</sys:Double>
    <!--  应用程序总标题  -->
    <sys:Double x:Key="FontSizeFTitle">25</sys:Double>
    <!--  ==================== 全局默认文本样式 ====================  -->
    <!--  目标类型设为 TextBlock，且没有 x:Key，隐式样式  -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI" />
        <!--  统一字体  -->
        <!--  在这里统一设置默认的前景色  -->
        <!-- <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/> -->
    </Style>
</ResourceDictionary>