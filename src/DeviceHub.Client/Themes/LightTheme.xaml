<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 标题栏 -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#2C3E50"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFFFFF"/>

    <!-- 窗口按钮 -->
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#E81123"/>

    <!-- 窗口背景 / 文字 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E6FFFFFF"/>
    <!-- 90% 不透明 -->
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#000000"/>


    <!-- 通用控件 -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>

    <!-- 导航栏 -->
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="NavForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="NavItemSelectedBrush" Color="#FFFFFF"/>
</ResourceDictionary>