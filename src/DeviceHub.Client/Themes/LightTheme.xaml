<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 主色 -->
    <Color x:Key="PrimaryColor">#1890FF</Color>
    <Color x:Key="PrimaryDarkColor">#096DD9</Color>
    <Color x:Key="PrimaryLightColor">#E6F7FF</Color>

    <!-- 状态色 -->
    <Color x:Key="SuccessColor">#52C41A</Color>
    <Color x:Key="WarningColor">#FAAD14</Color>
    <Color x:Key="DangerColor">#FF4D4F</Color>
    <Color x:Key="DangerDarkColor">#D9363E</Color>

    <!-- 中性色 -->
    <Color x:Key="TextPrimaryColor">#1F1F1F</Color>
    <Color x:Key="TextSecondaryColor">#595959</Color>
    <Color x:Key="TextDisabledColor">#8C8C8C</Color>
    <Color x:Key="BorderColor">#D9D9D9</Color>
    <Color x:Key="BorderLightColor">#F0F0F0</Color>

    <!-- 背景 -->
    <Color x:Key="BackgroundColor">#FAFAFA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#F5F5F5</Color>
    <Color x:Key="HeaderBackgroundColor">#FAFAFA</Color>

    <!-- 左侧菜单 -->
    <Color x:Key="SidebarBackgroundColor">#001529</Color>
    <Color x:Key="SidebarTextColor">#FFFFFF</Color>
    <Color x:Key="SidebarTextSecondaryColor">#A6ADB4</Color>
    <Color x:Key="SidebarItemHoverColor">#000C17</Color>
    <Color x:Key="SidebarItemActiveColor">#1890FF</Color>

    <!-- 标题栏 -->
    <Color x:Key="TitleBarBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TitleBarForegroundColor">#1F1F1F</Color>
</ResourceDictionary>