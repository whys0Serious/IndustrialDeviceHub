<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 主色（科技工业蓝） ========== -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryDarkColor">#1D4ED8</Color>
    <Color x:Key="PrimaryLightColor">#EFF6FF</Color>
    <!-- 调浅，作为悬浮底色 -->

    <!-- ========== 状态色（降低刺眼度，增加质感） ========== -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <!-- 运行中，稍微偏青的绿，更现代 -->
    <Color x:Key="SuccessLightColor">#D1FAE5</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningLightColor">#FEF3C7</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <!-- 报警，柔和的亮红 -->
    <Color x:Key="DangerDarkColor">#B91C1C</Color>
    <Color x:Key="DangerLightColor">#FEE2E2</Color>

    <!-- ========== 中性色（统一使用灰蓝色调，避免死黑） ========== -->
    <Color x:Key="TextPrimaryColor">#1E293B</Color>
    <!-- 主标题/正文 -->
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <!-- 表头/备注 -->
    <Color x:Key="TextDisabledColor">#94A3B8</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <!-- 边框调浅，减少线框感，更透气 -->
    <Color x:Key="BorderLightColor">#F1F5F9</Color>

    <!-- ========== 背景色（关键优化点：拉开层次但不刺眼） ========== -->
    <Color x:Key="BackgroundColor">#F4F7F9</Color>
    <!-- ★ 应用大背景，冷灰白 -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <!-- 卡片/表格纯白 -->
    <Color x:Key="SurfaceHoverColor">#F8FAFC</Color>
    <!-- 表格行悬浮色 -->
    <Color x:Key="HeaderBackgroundColor">#F8FAFC</Color>
    <!-- 表头背景 -->

    <!-- 弹窗遮罩 -->
    <Color x:Key="OverlayColor">#66000000</Color>

    <!-- ========== 左侧菜单（关键优化点：深灰蓝，与整体融合） ========== -->
    <Color x:Key="SidebarBackgroundColor">#1E293B</Color>
    <!-- ★ 改为石板灰蓝，不再是死黑 -->
    <Color x:Key="SidebarTextColor">#F8FAFC</Color>
    <!-- 正常菜单项文字 -->
    <Color x:Key="SidebarTextSecondaryColor">#94A3B8</Color>
    <!-- 未选中项文字 -->
    <Color x:Key="SidebarItemHoverColor">#334155</Color>
    <!-- 悬浮背景 -->
    <Color x:Key="SidebarItemActiveColor">#2563EB</Color>
    <!-- 选中背景（科技蓝） -->

    <!-- ========== 标题栏（关键优化点：解决右上角图标消失） ========== -->
    <Color x:Key="TitleBarBackgroundColor">#1E293B</Color>
    <!-- ★ 建议将顶部标题栏与左侧同色，形成倒L型框架，更稳重 -->
    <Color x:Key="TitleBarForegroundColor">#FFFFFF</Color>
    <!-- ★ 图标和文字改为纯白，确保可见 -->
    <Color x:Key="TitleBarButtonHoverColor">#334155</Color>
    <!-- 悬浮底色 -->
    <Color x:Key="TitleBarButtonPressedColor">#475569</Color>

    <!-- ========== 报警横幅 ========== -->
    <Color x:Key="AlarmBannerColor">#FEF3C7</Color>
    <Color x:Key="AlarmBannerTextColor">#92400E</Color>
    <Color x:Key="AlarmBannerNormalColor">#D1FAE5</Color>
    <Color x:Key="AlarmBannerLightColor">#FEF3C7</Color>
    <Color x:Key="AlarmDarkColor">#D97706</Color>

</ResourceDictionary>