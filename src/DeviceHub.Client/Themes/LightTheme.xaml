<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 主色 ========== -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryDarkColor">#1D4ED8</Color>
    <Color x:Key="PrimaryLightColor">#DBEAFE</Color>

    <!-- ========== 状态色 ========== -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessLightColor">#DCFCE7</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningLightColor">#FEF3C7</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerDarkColor">#B91C1C</Color>
    <Color x:Key="DangerLightColor">#FEE2E2</Color>

    <!-- ========== 中性色 ========== -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <!-- 更深的文字 -->
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextDisabledColor">#94A3B8</Color>
    <Color x:Key="BorderColor">#CBD5E1</Color>
    <!-- 边框更深 -->
    <Color x:Key="BorderLightColor">#E2E8F0</Color>

    <!-- ========== 背景（拉开层次） ========== -->
    <Color x:Key="BackgroundColor">#EEF2F7</Color>
    <!-- ★ 应用背景更深 -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <!-- ★ 卡片纯白 -->
    <Color x:Key="SurfaceHoverColor">#F1F5F9</Color>
    <Color x:Key="HeaderBackgroundColor">#F8FAFC</Color>

    <!-- ★ 新增：弹窗遮罩 -->
    <Color x:Key="OverlayColor">#66000000</Color>

    <!-- ========== 左侧菜单 ========== -->
    <Color x:Key="SidebarBackgroundColor">#0F1A2B</Color>
    <Color x:Key="SidebarTextColor">#F5F7FA</Color>
    <Color x:Key="SidebarTextSecondaryColor">#8A93A3</Color>
    <Color x:Key="SidebarItemHoverColor">#1A2740</Color>
    <Color x:Key="SidebarItemActiveColor">#2563EB</Color>

    <!-- ========== 标题栏 ========== -->
    <Color x:Key="TitleBarBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TitleBarForegroundColor">#0F172A</Color>
    <Color x:Key="TitleBarButtonHoverColor">#F1F5F9</Color>
    <Color x:Key="TitleBarButtonPressedColor">#E2E8F0</Color>

    <!-- ========== 报警横幅 ========== -->
    <Color x:Key="AlarmBannerColor">#FEF3C7</Color>
    <Color x:Key="AlarmBannerTextColor">#92400E</Color>
    <Color x:Key="AlarmBannerNormalColor">#DCFCE7</Color>
    <Color x:Key="AlarmBannerLightColor">#FEF3C7</Color>
    <Color x:Key="AlarmDarkColor">#D97706</Color>

</ResourceDictionary>